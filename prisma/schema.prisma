datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. FAMÍLIAS E USUÁRIOS
// ------------------------------------------------------

model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  missions Mission[]
}

model User {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  email     String?  @unique
  password  String?
  role      String   @default("CHILD") // PARENT ou CHILD
  avatarUrl String?
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  progress           ChildProgress?
  missionLogs        MissionLog[]
  journalEntries     JournalEntry[]
  observatoryLogs    ObservatoryInsight[]
  allowanceTransfers AllowanceTransfer[]
}

// ------------------------------------------------------
// 2. PROGRESSO E HABILIDADES (O MAPA)
// ------------------------------------------------------

model ChildProgress {
  id      String @id @default(uuid())
  userId  String @unique
  totalXp Int    @default(0)
  level   Int    @default(1)

  xpExplorador  Int @default(0)
  xpCriador     Int @default(0)
  xpComunicador Int @default(0)
  xpGuardiao    Int @default(0)
  xpAtleta      Int @default(0)
  xpCientista   Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 3. MISSÕES FIXAS + TAREFA DO DIA
// ------------------------------------------------------
// Missão  = botão fixo do Thales (EXPLORADOR, CRIADOR...)
// Tarefa  = o que o Responsável manda agora (activeTask + xpReward)
// O Responsável NÃO cria botão novo: atualiza a tarefa da missão.

model Mission {
  id            String  @id @default(uuid())
  familyId      String?
  title         String
  description   String
  skillArea     String
  xpReward      Int     @default(25)
  icon          String?
  isAiGenerated Boolean @default(false)

  /// Tarefa atual definida pelo Responsável.
  /// Se estiver vazia, a tela usa description.
  activeTask String @default("")

  /// true = carta/botão fixo do painel
  isTrack Boolean @default(true)

  createdAt DateTime  @default(now())
  /// Opcional = NÃO força reset com missões já existentes
  updatedAt DateTime? @updatedAt

  family Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  logs   MissionLog[]

  @@index([skillArea])
  @@index([isTrack])
}

model MissionLog {
  id           String    @id @default(uuid())
  userId       String
  missionId    String
  status       String    @default("AVAILABLE") // AVAILABLE, IN_PROGRESS, PENDING_VALIDATION, APPROVED, COMPLETED, SKIPPED
  completedAt  DateTime?
  feedbackText String?

  /// Cópia da tarefa/XP no momento do envio
  taskSnapshot String?
  xpSnapshot   Int?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 4. O DIÁRIO E BANCO DE MEMÓRIAS
// ------------------------------------------------------

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  question  String
  type      String   @default("TEXT") // VOICE, TEXT, DRAWING
  content   String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 5. O OBSERVATÓRIO (INSIGHTS PARA OS PAIS)
// ------------------------------------------------------

model ObservatoryInsight {
  id        String   @id @default(uuid())
  userId    String
  category  String
  trend     String
  aiComment String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 6. MESADA / TRANSFERÊNCIA (COFRE)
// ------------------------------------------------------

model AllowanceTransfer {
  id          String    @id @default(uuid())
  userId      String
  amountFree  Float
  amountSave  Float
  status      String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}